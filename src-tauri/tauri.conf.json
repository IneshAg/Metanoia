{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metanoia V2",
  "version": "0.2.0",
  "identifier": "com.metanoia.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Metanoia",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 400,
        "minHeight": 450,
        "backgroundColor": "#F3F0E9"
      },
      {
        "label": "floating-timer",
        "title": "Metanoia Focus",
        "url": "index.html?overlay=1",
        "width": 210,
        "height": 56,
        "minWidth": 130,
        "minHeight": 44,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icon.ico"
    ],
    "useLocalToolsDir": true
  }
}